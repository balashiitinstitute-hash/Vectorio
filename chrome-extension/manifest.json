{
  "manifest_version": 3,
  "name": "Vectorio AI → Gemini",
  "version": "1.3.0",
  "description": "Sends your selected Vectorio AI image and prompt to Gemini.",
  "permissions": [
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://vectorio-ai.vercel.app/*",
    "https://vectorify-ai.vercel.app/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vectorio-ai.vercel.app/*",
        "https://vectorify-ai.vercel.app/*"
      ],
      "js": [
        "vectorify.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "gemini.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
