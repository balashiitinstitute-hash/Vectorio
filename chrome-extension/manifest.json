{
  "manifest_version": 3,
  "name": "Vectorio AI – Gemini Assistant",
  "version": "2.1.0",
  "description": "Send images and prompts from Vectorio AI to Gemini.",
  "permissions": [
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://vectorio-ai.vercel.app/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vectorio-ai.vercel.app/*"
      ],
      "js": [
        "vectorio.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "gemini.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
